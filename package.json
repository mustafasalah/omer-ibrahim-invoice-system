{
  "name": "omer-ibrahim-invoice-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first sales invoice management system",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --conditions=react-server --import tsx scripts/run-next.ts dev",
    "build": "node scripts/run-next-build.mjs",
    "start": "node --conditions=react-server --import tsx scripts/run-next.ts start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "node --conditions=react-server node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --conditions=react-server --import tsx scripts/db-migrate.ts",
    "db:check": "node --conditions=react-server --import tsx scripts/db-check.ts",
    "seed:dev": "node --conditions=react-server --import tsx scripts/seed-dev.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "better-sqlite3": "13.0.3",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.2",
    "next": "16.3.3",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
